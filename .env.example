# Copy to .env.local (git-ignored). Server-side only: never prefix these with VITE_, that ships them to the browser.
# DeskAgent's model calls go through OpenRouter. Key from https://openrouter.ai/keys
# Production: use the project's own OpenRouter key, named "AgentOps Control Hub" in OpenRouter (credit limit set).
# Put it in .env.local on the server, which git ignores. Never commit the key.
OPENROUTER_API_KEY=
# Optional. An id from https://openrouter.ai/models. Defaults to openai/gpt-6-luna.
OPENROUTER_MODEL=
# Optional. DeskAgent runs each account may start per UTC day. Defaults to 5.
AI_DAILY_LIMIT=
# The only folder DeskAgent may touch. Defaults to your home folder.
AGENT_ROOT=
# Optional. Signup emails a 6-digit code when both are set. For Gmail use an App Password, not your normal password.
SMTP_USER=
SMTP_PASS=
# Defaults: smtp.gmail.com and 465 (implicit TLS).
SMTP_HOST=
SMTP_PORT=
PORT=8787
DB_PATH=agentops.db
    