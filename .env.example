# Copy to .env.local (git-ignored). Server-side only: never prefix these with VITE_, that ships them to the browser.
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-luna.
OPENAI_MODEL=
# The only folder DeskAgent may touch. Defaults to your home folder.
AGENT_ROOT=
# Optional. Signup emails a 6-digit code when both are set. For Gmail use an App Password, not your normal password.
SMTP_USER=
SMTP_PASS=
# Defaults: smtp.gmail.com and 465 (implicit TLS).
SMTP_HOST=
SMTP_PORT=
PORT=8787
DB_PATH=agentops.db
    